    <a href="/customers"<%- /^\/customers/.test(currentPath) ? ' class="active"' : '' %>><%- icon('customers', 22) %> Customers</a>
    <a href="/invoices"<%- /^\/invoices/.test(currentPath) ? ' class="active"' : '' %>><%- icon('invoices', 22) %> Invoices</a>
  </nav>
</div>
</body>
</html>
