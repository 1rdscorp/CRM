    </div>
  </main>

  <nav class="tabbar" aria-label="Main">
    <a href="/"<%- currentPath === '/' ? ' class="active"' : '' %>><%- icon('dashboard', 22) %> Home</a>
    <a href="/jobs"<%- /^\/jobs(?!\/new)/.test(currentPath) ? ' class="active"' : '' %>><%- icon('jobs', 22) %> Jobs</a>
