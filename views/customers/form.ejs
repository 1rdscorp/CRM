<%- include('../partials/top', { narrow: true }) %>
<header class="page-head">
  <div>
    <a class="crumb" href="<%= customer.id ? '/customers/' + customer.id : '/customers' %>"><%- icon('back', 14) %> <%= customer.id ? 'Back to customer' : 'Customers' %></a>
    <h1><%= customer.id ? 'Edit customer' : 'New customer' %></h1>
  </div>
</header>

<form class="card" method="post" action="<%= customer.id ? '/customers/' + customer.id : '/customers' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if (error) { -%>
  <div class="form-error" role="alert"><%= error %></div>
<% } -%>
  <div class="field">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" value="<%= customer.name %>" maxlength="120" required autocomplete="off"<%= customer.id ? '' : ' autofocus' %>>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="phone">Phone</label>
      <input type="tel" id="phone" name="phone" value="<%= customer.phone %>" maxlength="40" autocomplete="off">
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= customer.email %>" maxlength="200" autocomplete="off">
    </div>
  </div>
  <div class="field">
    <label for="address">Address</label>
    <textarea id="address" name="address" maxlength="400" rows="2" style="min-height: 62px" placeholder="Street&#10;City, State ZIP" autocomplete="off"><%= customer.address %></textarea>
  </div>
  <div class="field">
    <label for="notes">Notes</label>
    <textarea id="notes" name="notes" maxlength="4000" placeholder="Anything worth remembering about this customer"><%= customer.notes %></textarea>
  </div>
  <div class="form-actions">
    <button class="btn btn-primary" type="submit"><%= customer.id ? 'Save changes' : 'Add customer' %></button>
    <a class="btn btn-ghost" href="<%= customer.id ? '/customers/' + customer.id : '/customers' %>">Cancel</a>
  </div>
</form>
<%- include('../partials/bottom') %>
